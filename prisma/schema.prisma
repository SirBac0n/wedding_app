// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema
//
// Local dev uses sqlite (zero-setup, see prisma.config.ts). Production is
// meant to run on Postgres per REQUIREMENTS.md section 6 — switching providers
// means changing `provider` here, swapping the driver adapter in prisma.config.ts
// and lib/db.ts, and re-running migrations against the new database.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum AdminRole {
  FULL_ADMIN
  FAMILY_ADMIN
}

enum OutreachChannel {
  EMAIL
  SMS
}

enum OutreachPurpose {
  ADDRESS_COLLECTION
  RSVP_REMINDER
}

enum RsvpAuditSource {
  GUEST
  ADMIN
}

// RESERVED is a lightweight double-purchase mitigation (REQUIREMENTS.md
// section 7): admin can mark a fund claimed as soon as they're notified,
// before formally marking it FULFILLED, so a second guest doesn't buy the
// same off-registry item in the gap.
enum CashFundStatus {
  OPEN
  RESERVED
  FULFILLED
}

// Drives the payment-link platform picker (admin enters just a
// handle/cashtag/contact, the app builds the full link) and the
// public-page rendering — Zelle has no shareable payment URL, so ZELLE
// funds show paymentLink as contact info (email/phone) rather than a
// clickable button. See src/lib/payment-link.ts.
enum PaymentPlatform {
  VENMO
  PAYPAL
  CASHAPP
  ZELLE
  OTHER
}

enum RsvpQuestionType {
  TEXT
  YES_NO
}

enum RsvpQuestionScope {
  GUEST
  HOUSEHOLD
}

// Full Admin (the couple) or Family Admin (e.g. parents) — see REQUIREMENTS.md section 3.
model Admin {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         AdminRole
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  rsvpAuditLogs    RsvpAuditLog[]
  registryItems    RegistryItem[]
  cashFunds        CashFund[]
}

// Site-wide, single-row settings the admin controls (section 4.9).
model EventSettings {
  id                    Int       @id @default(1)
  weddingDate           DateTime?
  timezone              String    @default("America/Chicago")
  rsvpCutoffAt          DateTime?
  tableLookupEnabled    Boolean   @default(false)
  registryRevealAt      DateTime?
  dataRetentionMonths   Int       @default(6)
  // Fallback contact shown when a guest can't find their name in the address
  // collection / RSVP lookup (REQUIREMENTS.md section 4.3).
  contactEmail          String?

  // RSVP form customization (Full Admin only) — show/hide toggles for the
  // two built-in optional fields. Meal choice itself is hidden automatically
  // when there are no active MealOption rows, so it doesn't need its own flag.
  rsvpShowSongRequest   Boolean   @default(true)
  rsvpShowDietaryNotes  Boolean   @default(true)

  updatedAt             DateTime  @updatedAt
}

// Admin-managed meal choices for the RSVP form. An empty list hides the meal
// picker entirely rather than needing a separate on/off toggle.
model MealOption {
  id        String   @id @default(cuid())
  label     String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

// Admin-defined extra RSVP questions beyond the built-in fields, scoped to
// either each guest or the household as a whole.
model RsvpQuestion {
  id        String            @id @default(cuid())
  label     String
  type      RsvpQuestionType
  scope     RsvpQuestionScope
  sortOrder Int               @default(0)
  active    Boolean           @default(true) // inactive questions keep past answers but stop being asked
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  answers   RsvpAnswer[]
}

// One answer to one custom question, for one guest or one household
// depending on the question's scope — exactly one of guestId/householdId is
// set, matching the RsvpAuditLog nullable-FK pattern rather than a required
// scalar that could point nowhere.
model RsvpAnswer {
  id          String       @id @default(cuid())
  questionId  String
  question    RsvpQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  guestId     String?
  guest       Guest?       @relation(fields: [guestId], references: [id], onDelete: Cascade)
  householdId String?
  household   Household?   @relation(fields: [householdId], references: [id], onDelete: Cascade)

  value       String

  updatedAt   DateTime     @updatedAt

  @@unique([questionId, guestId])
  @@unique([questionId, householdId])
}

// A reception table (section 4.6). A first-class model rather than a free
// string on Household so empty tables — the ones nobody's assigned to yet —
// still exist to drag guests onto in the seating-chart board.
model Table {
  id        String      @id @default(cuid())
  label     String // e.g. "1", "Head Table"
  capacity  Int? // optional; shown as a fill indicator, not enforced
  sortOrder Int         @default(0)
  createdAt DateTime    @default(now())

  households Household[]
}

// The unit RSVPs and addresses attach to (section 4.2). Two households can
// share a surname (e.g. divorced parents) — nothing forces one-per-family.
model Household {
  id               String   @id @default(cuid())
  displayName      String // e.g. "The Smith Family" — admin-set label for list views

  // Contact info: email and/or phone, guest's choice (section 4.3). Phone is
  // normalized to E.164 on save (section 5).
  email            String?
  phone            String?

  addressLine1     String?
  addressLine2     String?
  city             String?
  state            String?
  postalCode       String?
  country          String?

  notes            String? // allergies/notes free-text (household-level)
  songRequest      String? // one per household (section 4.5)
  tableId          String? // null = not assigned yet (section 4.6)
  table            Table?   @relation(fields: [tableId], references: [id], onDelete: SetNull)
  thankYouSent     Boolean  @default(false)

  rsvpSubmittedAt  DateTime?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  guests           Guest[]
  outreachMessages OutreachMessage[]
  rsvpAuditLogs    RsvpAuditLog[]
  rsvpAnswers      RsvpAnswer[]
}

// A named individual within a household — plus-ones/kids are pre-loaded by
// admin, guests cannot add their own (section 4.4/4.5).
model Guest {
  id               String   @id @default(cuid())
  householdId      String
  household        Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  firstName        String
  lastName         String
  alias            String? // nickname / maiden name / alt spelling, for lookup matching (section 4.2)
  relationshipSide String? // e.g. "Bride's side", "Groom's side"
  isChild          Boolean  @default(false)

  attending        Boolean? // null = no response yet
  mealChoice       String?
  dietaryNotes     String?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  rsvpAnswers      RsvpAnswer[]
}

// Log of address-collection invites and RSVP reminders sent to a household
// (section 4.4). Token is stored hashed; the raw token only ever lives in the
// link sent to the guest.
model OutreachMessage {
  id           String          @id @default(cuid())
  householdId  String
  household    Household       @relation(fields: [householdId], references: [id], onDelete: Cascade)

  channel      OutreachChannel
  purpose      OutreachPurpose
  tokenHash    String          @unique
  expiresAt    DateTime
  usedAt       DateTime?

  sentAt       DateTime        @default(now())
}

// Audit trail for RSVP submissions/edits (section 4.5 trade-off mitigation) —
// distinguishes guest self-service from admin proxy-entry.
model RsvpAuditLog {
  id           String     @id @default(cuid())
  householdId  String
  household    Household  @relation(fields: [householdId], references: [id], onDelete: Cascade)

  // adminId is only set (and only FK-checked) when source is ADMIN — a guest
  // submission has no Admin row to point at, so it must be a nullable FK
  // rather than a required scalar holding a sentinel string like "guest".
  source       RsvpAuditSource
  adminId      String?
  admin        Admin?     @relation(fields: [adminId], references: [id])
  summary      String

  createdAt    DateTime   @default(now())
}

// Scoped, revocable token for the browser extension (section 4.8/5) — grants
// cash-fund creation only, never full admin access. Stored hashed.
model ExtensionToken {
  id          String    @id @default(cuid())
  tokenHash   String    @unique
  label       String // e.g. "Sarah's laptop" — helps admin identify which to revoke

  createdById String
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime?
  revokedAt   DateTime?
}

// External registry link-out cards (section 4.7).
model RegistryItem {
  id         String   @id @default(cuid())
  title      String
  url        String
  logoUrl    String?
  sortOrder  Int      @default(0)

  createdById String
  createdBy   Admin   @relation(fields: [createdById], references: [id])

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// Couple-managed cash funds, incl. items created via the browser extension
// (section 4.7/4.8). v1 tracking is manual; see REQUIREMENTS.md section 8 for
// the planned v2 payment-processing/auto-progress upgrade.
model CashFund {
  id               String         @id @default(cuid())
  title            String
  description      String?
  imageUrl         String?
  sourceUrl        String? // the product page it was created from, if any
  goalAmountCents  Int?
  amountRaisedCents Int           @default(0) // admin-updated manually in v1
  paymentPlatform  PaymentPlatform @default(OTHER)
  paymentLink      String // full URL for VENMO/PAYPAL/CASHAPP/OTHER; email or phone (not a URL) for ZELLE
  status           CashFundStatus @default(OPEN)

  createdById      String
  createdBy        Admin          @relation(fields: [createdById], references: [id])

  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}
